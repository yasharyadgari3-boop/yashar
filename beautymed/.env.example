# فایل نمونه‌ی تنظیمات. یک کپی از این فایل با نام .env بسازید و مقدارها را پر کنید.
# فایل .env هرگز نباید در گیت ثبت شود (در .gitignore آمده است).

# نشانی پایگاه داده‌ی PostgreSQL. قالب: postgresql://کاربر:رمز@میزبان:۵۴۳۲/نام‌پایگاه
# برای اجرای محلی، همان کاربر و پایگاهی که روی کامپیوتر خودتان ساخته‌اید. روی هاست، از پنل هاست می‌گیرید.
DATABASE_URL="postgresql://beautymed:CHANGE_ME@localhost:5432/beautymed_dev"

# رمز داخلی برنامه برای کدهای ورود (حداقل ۳۲ نویسه‌ی تصادفی). خودتان می‌سازید؛ از جایی گرفته نمی‌شود.
# برای ساختن، این دستور را در ترمینال اجرا کنید و خروجی را اینجا بگذارید:  openssl rand -hex 32
AUTH_SECRET=""

# نشانی سایت. محلی: http://localhost:3000   روی هاست: https://beautymed.ir
APP_URL="http://localhost:3000"

# شماره‌ی موبایل مدیر(ان) سایت، با ویرگول جدا شود. هر کس با این شماره وارد شود مدیر می‌شود.
ADMIN_MOBILES=""

# سرویس پیامک. فعلاً فقط mock (کد را در ترمینال و صفحه‌ی ورود نشان می‌دهد و پیامک واقعی نمی‌فرستد).
# پس از انتخاب شرکت پیامک، نام آن اینجا می‌آید و کلیدش از پنل همان شرکت گرفته می‌شود.
SMS_PROVIDER="mock"

# درگاه پرداخت. فعلاً فقط mock (پرداخت آزمایشی، بدون پول واقعی).
# پس از انتخاب درگاه شاپرکی، نام آن اینجا می‌آید و کد پذیرنده از پنل همان درگاه گرفته می‌شود.
PAYMENT_GATEWAY="mock"

# هشدار: این گزینه سرویس‌های آزمایشی (mock) را در نسخه‌ی نهایی هم فعال می‌کند.
# فقط برای آزمایش روی کامپیوتر خودتان. روی سایت واقعی هرگز true نگذارید.
ALLOW_MOCKS_IN_PRODUCTION="false"

# پوشه‌ی نگهداری فایل‌های خصوصی (مدارک نظام پزشکی). اگر خالی بماند: .data/private
PRIVATE_STORAGE_DIR=""

# اختیاری: اگر file باشد، مشترکین خبرنامه به‌جای پایگاه داده در فایل ذخیره می‌شوند (فقط برای آزمایش).
NEWSLETTER_STORE=""
NEWSLETTER_FILE=""
