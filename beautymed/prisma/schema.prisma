// BeautyMed data model.
// Conventions (see docs/PROGRESS.md): every timestamp is timestamptz, prices are whole Toman
// integers, every foreign key is indexed, medical/commercial records are soft-deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PHYSICIAN
  IMPORTER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  /// Normalized Iranian mobile number: 09xxxxxxxxx
  mobile    String    @unique
  /// Null until the person chooses physician or importer during onboarding.
  role      Role?
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  physician PhysicianProfile?
  importer  ImporterProfile?
  sessions  Session[]
  documents VerificationDocument[]
  auditLogs AuditLog[]
  cart      Cart?
  orders    Order[]
  lessonProgress LessonProgress[]
}

model PhysicianProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  fullName             String
  /// شماره نظام پزشکی
  medicalCouncilNumber String
  clinicName           String?
  status               VerificationStatus @default(PENDING)
  rejectionReason      String?
  reviewedById         String?
  reviewedAt           DateTime?          @db.Timestamptz
  createdAt            DateTime           @default(now()) @db.Timestamptz
  updatedAt            DateTime           @updatedAt @db.Timestamptz

  @@index([status, createdAt])
}

model ImporterProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id])
  companyName     String
  /// شناسه ملی شرکت
  nationalId      String
  contactName     String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  /// Partner logos are shown only for companies an admin marks as having given written permission.
  logoPermission  Boolean            @default(false)
  reviewedById    String?
  reviewedAt      DateTime?          @db.Timestamptz
  createdAt       DateTime           @default(now()) @db.Timestamptz
  updatedAt       DateTime           @updatedAt @db.Timestamptz

  products   Product[]
  orderItems OrderItem[]
  proposals  CollaborationProposal[]

  @@index([status, createdAt])
}

/// A private file (license, company papers). Stored outside any public path; served only
/// through an authenticated route to its owner or an admin.
model VerificationDocument {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  kind         String
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([ownerId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  mobile     String
  /// HMAC of the code; the code itself is never stored.
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([mobile, createdAt])
  @@index([ip, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  /// "email" or "mobile"
  kind        String
  value       String
  consentText String
  consentAt   DateTime @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([kind, value])
}

/// Admin-editable settings, including compliance rules the owner will confirm with a lawyer.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Store (Phase 3)
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
}

enum ProposalStatus {
  NEW
  REVIEWED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  sortOrder Int       @default(0)
  products  Product[]
}

/// Submitted by an importer. Nothing is public until an admin publishes it, and publishing is
/// refused while the required compliance fields are empty.
model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String
  /// Normalized name and description, for Persian search.
  searchText      String
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  importerId      String
  importer        ImporterProfile @relation(fields: [importerId], references: [id])
  /// Whole Toman.
  priceToman      Int
  status          ProductStatus   @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  publishedAt     DateTime?       @db.Timestamptz
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz
  deletedAt       DateTime?       @db.Timestamptz

  compliance ProductCompliance?
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status, categoryId, publishedAt])
  @@index([categoryId])
  @@index([importerId, createdAt])
}

/// Regulatory details. Which of these are required before publishing is a site setting.
model ProductCompliance {
  id                  String   @id @default(cuid())
  productId           String   @unique
  product             Product  @relation(fields: [productId], references: [id])
  /// Iran FDA registration code (IRC).
  ircCode             String   @default("")
  importerName        String   @default("")
  authenticityDetails String   @default("")
  updatedAt           DateTime @updatedAt @db.Timestamptz
}

model ProductImage {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  storageKey     String   @unique
  mimeType       String
  alt            String
  /// Before/after images are shown only after an admin sets patientConsent.
  isBeforeAfter  Boolean  @default(false)
  patientConsent Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([productId, sortOrder])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  updatedAt DateTime   @updatedAt @db.Timestamptz
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  /// Human-readable order number shown to the buyer.
  number        String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING_PAYMENT)
  /// Whole Toman, fixed at checkout.
  totalToman    Int
  recipientName String
  phone         String
  city          String
  address       String
  postalCode    String
  note          String?
  paidAt        DateTime?   @db.Timestamptz
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Name and price are copied at checkout, so later product edits never change an order.
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  importerId     String
  importer       ImporterProfile @relation(fields: [importerId], references: [id])
  productName    String
  unitPriceToman Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
  @@index([importerId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  gateway     String
  /// The gateway's reference for this attempt. Unique, so a callback is applied once.
  authority   String        @unique
  amountToman Int
  status      PaymentStatus @default(INITIATED)
  refId       String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  verifiedAt  DateTime?     @db.Timestamptz

  @@index([orderId])
}

model CollaborationProposal {
  id         String          @id @default(cuid())
  importerId String
  importer   ImporterProfile @relation(fields: [importerId], references: [id])
  subject    String
  message    String
  status     ProposalStatus  @default(NEW)
  createdAt  DateTime        @default(now()) @db.Timestamptz

  @@index([importerId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Physician training (Phase 4)
// ---------------------------------------------------------------------------

model Course {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  summary    String
  /// Unpublished courses are visible to admins only.
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  /// Name of the physician who reviewed the course content; a notice shows while it is empty.
  reviewedBy String?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz
  lessons    Lesson[]

  @@index([published, sortOrder])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  slug            String
  title           String
  /// Plain text.
  body            String
  /// An https address or a path under /public. Empty until the owner provides the video.
  videoUrl        String?
  durationMinutes Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  progress        LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  completedAt DateTime @default(now()) @db.Timestamptz

  @@unique([userId, lessonId])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// PubMed library (Phase 5)
// ---------------------------------------------------------------------------

/// A saved PubMed search the admin can edit.
model PubmedTopic {
  id            String    @id @default(cuid())
  slug          String    @unique
  /// Persian title shown in the library.
  title         String
  /// PubMed query (MeSH terms where they exist).
  query         String
  enabled       Boolean   @default(true)
  sortOrder     Int       @default(0)
  lastFetchedAt DateTime? @db.Timestamptz
  articles      ArticleTopic[]
  runs          FetchRun[]
}

model Article {
  id          String    @id @default(cuid())
  pmid        String    @unique
  pmcid       String?
  doi         String?
  /// Original title.
  title       String
  /// Original abstract. Used as translation input only; it is not displayed (publisher copyright).
  abstract    String
  authors     Json
  journal     String
  /// Publication date as printed by PubMed (for example "2026 Nov").
  pubDateText String
  publishedAt DateTime? @db.Timestamptz
  /// Normalized license code read from PMC (for example "cc-by", "cc-by-nc"), or null.
  license     String?
  licenseUrl  String?
  /// True only when the article is in PMC with full text and its license allows commercial derivative works.
  fullTextTranslatable Boolean   @default(false)
  licenseCheckedAt     DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  topics       ArticleTopic[]
  translations ArticleTranslation[]

  @@index([publishedAt])
  @@index([createdAt])
}

model ArticleTopic {
  articleId String
  article   Article     @relation(fields: [articleId], references: [id])
  topicId   String
  topic     PubmedTopic @relation(fields: [topicId], references: [id])

  @@id([articleId, topicId])
  @@index([topicId])
}

enum TranslationKind {
  SUMMARY
  FULL_TEXT
}

/// Created the first time someone opens the article, then reused (translation cost follows use).
model ArticleTranslation {
  id        String          @id @default(cuid())
  articleId String
  article   Article         @relation(fields: [articleId], references: [id])
  kind      TranslationKind
  /// Persian title (SUMMARY only).
  titleFa   String?
  /// Persian summary of the abstract, or the Persian full text.
  text      String
  /// Which provider produced it ("mock" until a real one is connected).
  provider  String
  /// Every translation is machine-generated until an admin records a physician review.
  physicianReviewed Boolean   @default(false)
  reviewedById      String?
  reviewedAt        DateTime? @db.Timestamptz
  createdAt DateTime        @default(now()) @db.Timestamptz

  @@unique([articleId, kind])
}

model FetchRun {
  id         String      @id @default(cuid())
  topicId    String
  topic      PubmedTopic @relation(fields: [topicId], references: [id])
  startedAt  DateTime    @default(now()) @db.Timestamptz
  finishedAt DateTime?   @db.Timestamptz
  found      Int         @default(0)
  added      Int         @default(0)
  error      String?

  @@index([topicId, startedAt])
}
